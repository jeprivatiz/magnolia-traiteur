# Copier ce fichier en .env puis remplir. Sans base MySQL, les données vont dans var/db.json.
PORT=3000
SITE_URL=https://www.magnoliatraiteur.fr

# Base MySQL (Hostinger) — laisser vide pour l'essai en local
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Premier compte Manager du back-office (créé au démarrage s'il n'existe pas)
ADMIN_EMAIL=infos@magnoliatraiteur.fr
ADMIN_NAME=Romain Goujon
ADMIN_PASSWORD=

# Brevo (e-mails et SMS). Sans clé : mode test, rien n'est envoyé.
BREVO_API_KEY=
MAIL_FROM=infos@magnoliatraiteur.fr
MAIL_FROM_NAME=Magnolia Traiteur
SMS_SENDER=Magnolia
ALERT_EMAILS=infos@magnoliatraiteur.fr

# Photos envoyées depuis le back-office (dossier qui ne s'efface pas aux mises à jour)
UPLOAD_DIR=
